{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/app/*": ["app/*"],
      "@/components/*": ["src/components/*"],
      "@/database/*": ["src/database/*"],
      "@/services/*": ["src/services/*"],
      "@/state/*": ["src/state/*"],
      "@/theme": ["src/theme/index.ts"],
      "@/theme/*": ["src/theme/*"],
      "@/assets/*": ["assets/*"]
    }
  },

  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
