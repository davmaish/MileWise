{
  "expo": {
    "name": "MileWise",
    "slug": "milewise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "milewise",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D267D"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#1D267D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.davmaish.milewise"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davmaish.milewise",
      "infoPlist": {
        "NSCameraUsageDescription": "MileWise uses the camera to capture service receipts and vehicle photos.",
        "NSLocationWhenInUseUsageDescription": "MileWise uses your location to record where your vehicle was serviced.",
        "NSPhotoLibraryUsageDescription": "MileWise accesses your gallery to attach receipt photos to service records."
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "MileWise needs camera access to capture service receipts."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MileWise uses your location to record where your vehicle was serviced."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1D267D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b05538de-4c87-47d4-84a5-679006b6b4a7"
      }
    }
  }
}
